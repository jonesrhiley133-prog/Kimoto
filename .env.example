# Copy to .env and adjust. Everything is optional for local development.

# Where the web app is reachable (used for email links, OAuth redirects and socket CORS).
# In development the Vite dev server proxies the API, so this is the Vite URL.
PUBLIC_URL=http://localhost:5173
PORT=4000

# Storage
DATA_DIR=data                     # database, uploads and image cache
# LOCAL_LIBRARY_DIR=data/library  # folders of manga/novels you own (see docs/SOURCES.md)

# Email (verification + password reset). Without SMTP, emails are printed to the server log.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM=Kimoto <no-reply@example.com>

# MyAnimeList — register an app at https://myanimelist.net/apiconfig
#   App redirect URL: <PUBLIC_URL>/api/integrations/mal/callback
# MAL_CLIENT_ID=
# MAL_CLIENT_SECRET=

# AniList — create a client at https://anilist.co/settings/developer
#   Redirect URL: <PUBLIC_URL>/api/integrations/anilist/callback
# ANILIST_CLIENT_ID=
# ANILIST_CLIENT_SECRET=

# Web Push (generated and stored automatically if unset)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Behind an outbound HTTP proxy? Node's built-in fetch ignores HTTPS_PROXY unless this is set (Node 22.21+):
# NODE_USE_ENV_PROXY=1

# Identify this instance to upstream APIs (MangaDex asks for a descriptive User-Agent)
# HTTP_USER_AGENT=Kimoto/0.1 (+https://your-instance.example)
